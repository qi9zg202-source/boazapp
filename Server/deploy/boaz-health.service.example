[Unit]
Description=Boaz private HealthKit receiver
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=boaz-health
Group=boaz-health
EnvironmentFile=/etc/boaz-health/boaz-health.env
ExecStart=/opt/boaz-health/bin/boaz-health-receiver serve
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/boaz-health/data

[Install]
WantedBy=multi-user.target
