# Copy to a root-owned, mode-0600 environment file. Start with all gates closed.
BOAZ_HEALTH_DATA_ROOT=/opt/boaz-health/data
BOAZ_HEALTH_DB=/opt/boaz-health/data/health.db
BOAZ_HEALTH_CONTROL_DB=/opt/boaz-health/control/control.db
BOAZ_HEALTH_CONTROL_MIRROR_DIR=/opt/boaz-health/control/mirror
# Stable coordinator lives outside every switchable health/control/VM generation.
# It must be on the independently encrypted control volume, owned by root, mode 0700.
BOAZ_HEALTH_COORD_DIR=/opt/boaz-health/control/coord
# The binary now requires an adopted coordinator for all ordinary writes.
# Bootstrap is a separate offline command and must remain disabled in service.
# Coordination is mandatory in the binary; there is no disable switch.
BOAZ_HEALTH_BOOTSTRAP=0
# Required before any acknowledged batch or pairing; provision on a verified
# encrypted recovery device separate from both live SQLite devices.
# BOAZ_HEALTH_ACK_JOURNAL_DIR=/approved/encrypted/ack-journal
# Off-host custody uses one separately administered forced-command SSH account.
# Pin its host key and use a dedicated identity file; these placeholders are
# deliberately commented out and do not provision an independent custodian.
# BOAZ_HEALTH_CUSTODY_SSH_TARGET=boaz-custody@custody.example.invalid
# BOAZ_HEALTH_CUSTODY_KNOWN_HOSTS=/etc/boaz-health/custody-known-hosts
# BOAZ_HEALTH_CUSTODY_IDENTITY_FILE=/etc/boaz-health/custody-identity
BOAZ_HEALTH_BACKUP_DIR=/opt/boaz-health/backups
BOAZ_HEALTH_PORT=8787
BOAZ_HEALTH_VM_BINARY=/opt/boaz-health/bin/victoria-metrics-prod
BOAZ_HEALTH_VM_STORAGE=/opt/boaz-health/victoria-metrics-data
BOAZ_HEALTH_UPLOAD_ENABLED=0
BOAZ_HEALTH_DATA_VOLUME_ENCRYPTED=0
BOAZ_HEALTH_CONTROL_VOLUME_ENCRYPTED=0
BOAZ_HEALTH_BACKUP_VOLUME_ENCRYPTED=0
BOAZ_HEALTH_BACKUP_RESTORE_VERIFIED=0
BOAZ_HEALTH_TAILSCALE_PRIVATE_VERIFIED=0
